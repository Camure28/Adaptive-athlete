# Copy to .env.local and fill in from your Supabase project (Settings → API).
# Leave unset to run the app in demo mode (nothing is saved).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Where "Send feedback" in Profile emails go (a support address, not a personal one). Optional.
EXPO_PUBLIC_SUPPORT_EMAIL=
